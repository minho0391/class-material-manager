# 의존성
node_modules/

# 수집한 자료 전체 (강사 저작물 · 개인정보 보호를 위해 git에 올리지 않음)
# 변경 이력은 git 대신 data/history/ 폴더에 직접 보존한다.
data/

# 인증 정보 (혹시 프로젝트 루트에 두게 될 경우 대비)
.env
*.token.json
credentials.json

# 로그 · OS 부산물
*.log
.DS_Store
Thumbs.db

# TypeScript 증분 빌드 캐시 (소스가 아님)
viewer/tsconfig.tsbuildinfo
*.tsbuildinfo

# Playwright
test-results/
playwright-report/

# E2E 로그인 상태 저장 파일 (실제 세션 쿠키가 들어 있습니다)
e2e/.auth/

.vercel
.env*

# AI 도구 · 로컬 개발환경 설정 (이 PC 전용, 빌드·테스트·CI·배포와 무관)
# - .agents/ .claude/  : Claude Code 스킬·개인 permission allowlist (공유 설정은 루트 CLAUDE.md)
# - .mcp.json          : Supabase MCP 서버 엔드포인트 (동기화는 supabase CLI + env 로 동작)
# - ClassMaterialManager.bat : 절대경로가 박힌 개인 dev 서버 런처
# - skills-lock.json   : 로컬 Skill(hallmark) 설치 상태·해시 기록 (.agents/ 와 한 쌍)
.agents/
.claude/
.mcp.json
/ClassMaterialManager.bat
/skills-lock.json

# 대체된 v1 디자인 시안 (검토용 PNG · 현재 기준안은 design-mockups-v2/)
/design-mockups/
