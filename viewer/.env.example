# 이 파일은 **예시**입니다. 실제 값은 들어 있지 않습니다.
#
# 쓰려면 이 파일을 `.env.local` 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env.local
#
# Next.js 는 이 폴더의 .env / .env.local 을 시작할 때 자동으로 읽습니다.
# (프로젝트 루트의 CLI 와 달리 --env-file 을 따로 줄 필요가 없습니다)
# `.env*` 파일은 .gitignore 에 들어 있어 git 에 올라가지 않습니다 (.env.example 은 예외).


# ── Supabase 로그인 (필수) ─────────────────────────────────────
#
# 이 값이 없으면 로그인 화면 자체가 뜨지 않고 오류 화면이 뜹니다.
# (GITHUB_TOKEN 과 달리 선택 사항이 아닙니다 — 로그인 기능이 이 값에 의존합니다)
#
# Supabase 프로젝트 → Settings → API 에서 두 값을 그대로 복사하세요.
# ANON KEY 는 브라우저에 노출되어도 되는 "공개" 키입니다 — 대신 Supabase 쪽
# RLS(행 단위 보안, Row Level Security)로 실제 접근을 막습니다.
#
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── 24시간 자동 갱신 (선택 사항이지만, 없으면 자동 갱신이 조용히 꺼집니다) ──────
#
# 첫 접속을 트리거로 한 24시간 주기 백그라운드 자동 갱신에 씁니다
# (viewer/lib/refresh/trigger.ts, .github/workflows/material-refresh.yml 참고).
# 둘 중 하나라도 없으면 이 기능만 조용히 건너뛰고, 로그인·자료 열람 등 나머지
# 기능은 평소처럼 동작합니다. 로컬 개발에서는 보통 비워 둡니다.
#
# SUPABASE_SERVICE_ROLE_KEY 는 RLS를 우회하는 권한입니다 — 브라우저로 절대
# 내보내면 안 됩니다 (NEXT_PUBLIC_ 접두어를 붙이지 마세요). 서버 전용 코드에서만
# 읽습니다.
#
SUPABASE_SERVICE_ROLE_KEY=

# GitHub Actions 워크플로우(material-refresh.yml)를 원격 트리거하는 데만 씁니다.
# repository_dispatch 를 보낼 수 있는 권한만 있으면 됩니다
# (fine-grained PAT: 이 저장소에 Contents: Read and write, 또는 classic PAT: repo scope).
# 이 프로젝트 코드를 읽거나 고치는 데는 쓰이지 않습니다 — 트리거 API 호출 한 번뿐입니다.
GH_DISPATCH_TOKEN=


# ── E2E 시험 계정 (선택 사항) ────────────────────────────────────
#
# `npm run e2e` 가 로그인까지 확인하려면 미리 만들어 둔 계정이 필요합니다.
# (회원가입 화면이 없으므로 Supabase 콘솔에서 미리 사용자를 만들어 두세요)
#
# 없어도 됩니다 — 없으면 로그인이 필요한 시험만 건너뛰고 나머지는 그대로 돕니다.
#
E2E_SUPABASE_EMAIL=
E2E_SUPABASE_PASSWORD=
