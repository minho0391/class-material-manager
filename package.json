{
  "name": "class-material-manager",
  "version": "0.1.0",
  "private": true,
  "description": "수업자료(Google Docs)를 수집하고 과목별로 정리하며 공식 문서로 보충하는 개인 학습자료 관리 도구",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "refresh": "node src/index.ts refresh",
    "extract": "node src/index.ts extract",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "security-check": "node src/index.ts security-check",
    "backup": "node src/index.ts backup",
    "restore": "node src/index.ts restore"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "cheerio": "^1.0.0",
    "fflate": "^0.8.3",
    "google-auth-library": "^11.0.2",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.8.0"
  }
}
