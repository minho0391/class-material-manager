{
  // ─────────────────────────────────────────────────────────────
  // 이 프로젝트는 빌드 단계가 없습니다.
  // Node.js 24는 .ts 파일에서 타입 표기만 지워내고 그대로 실행할 수 있어서
  // (type stripping) `node src/index.ts` 로 바로 돌아갑니다.
  //
  // 따라서 tsconfig.json 의 역할은 "실행"이 아니라 두 가지입니다.
  //   1. 편집기(VS Code)가 타입 오류를 실시간으로 알려주게 한다
  //   2. `npm run typecheck` 로 전체 타입 검사를 한 번에 돌린다
  // ─────────────────────────────────────────────────────────────
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],

    // Node.js 의 ESM(import/export) 방식을 그대로 따른다
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // import 할 때 확장자를 .ts 로 적는다.
    // Node 가 파일을 직접 읽어 실행하므로 실제 파일명 그대로 써야 한다.
    "allowImportingTsExtensions": true,

    // 결과물을 만들지 않는다 (타입 검사 전용)
    "noEmit": true,

    // 타입 안전성을 최대로 켠다. 배우는 목적이라면 켜두는 편이 훨씬 낫다.
    "strict": true,
    "noUncheckedIndexedAccess": true,

    // import type 을 명시적으로 쓰게 강제한다 (Node 의 type stripping 과 잘 맞는다)
    "verbatimModuleSyntax": true,

    // ★ 중요: enum, namespace 처럼 "지우기만 해서는 실행될 수 없는" 문법을 금지한다.
    //   이걸 켜두면 Node 로 직접 실행되지 않는 코드를 애초에 쓸 수 없다.
    "erasableSyntaxOnly": true,

    // node_modules 안의 타입 정의까지 검사하면 느려지므로 건너뛴다
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
